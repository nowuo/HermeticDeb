# ==========================================
# 1. 忽略目录内容，但保留目录本身
# （注意：需要在这些目录下创建一个空的 .gitkeep 文件）
# ==========================================

# 构建产物目录
dist/*
!dist/.gitkeep

# 补丁目录
patches/*
!patches/.gitkeep

# 源码树目录
src/*
!src/.gitkeep

# ==========================================
# 2. 禁止同步的指定文件
# ==========================================
Dockerfile.base
versions.toml
